// Gerar a imagem: dot -Tpng -Gdpi=110 docs/design/casos-de-uso.dot -o static/img/diagrama-casos-de-uso.png
digraph casos_de_uso {
  rankdir=LR;
  nodesep=0.22;
  ranksep=1.3;
  node [fontname="Helvetica", fontsize=11];
  edge [arrowhead=none, color="#5b6b70"];

  node [shape=box, style="rounded,filled", fillcolor="#dcefed", color="#0b6e69"];
  visitante [label="Visitante"];
  dev [label="Desenvolvedor"];
  gerente [label="Gerente"];
  admin [label="Administrador"];

  subgraph cluster_sistema {
    label="Outsourcing";
    fontname="Helvetica";
    color="#d7dfdd";
    node [shape=ellipse, style=filled, fillcolor="#ffffff", color="#0b6e69"];
    sobre [label="Ver página sobre"];
    cadastro [label="Criar conta"];
    login [label="Entrar e sair"];
    conta [label="Gerenciar a própria conta"];
    quadro [label="Ver quadro kanban"];
    mover [label="Mover tarefa entre estágios"];
    tarefas [label="Gerenciar tarefas"];
    notas [label="Gerenciar anotações privadas"];
    horas [label="Apontar horas privadas"];
    assistente [label="Usar assistente de IA"];
    consumo [label="Ver meu consumo de IA"];
    projetos [label="Gerenciar seus projetos"];
    estagios [label="Gerenciar estágios"];
    verequipes [label="Consultar equipes"];
    equipes [label="Gerenciar equipes"];
    usuarios [label="Gerenciar usuários e papéis"];
    configia [label="Configurar e auditar a IA"];
  }

  visitante -> {sobre cadastro login};
  dev -> {login conta quadro mover tarefas notas horas assistente consumo};
  gerente -> {login conta quadro mover tarefas notas horas assistente consumo projetos estagios verequipes};
  admin -> {login conta quadro mover tarefas notas horas assistente consumo projetos estagios equipes usuarios configia};
}
