# Copie para `.env` e preencha. Nunca versione o `.env`.
SECRET_KEY=troque-esta-chave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# String de conexão do PostgreSQL da Neon.tech (não usar SQLite).
DATABASE_URL=postgres://usuario:senha@host.neon.tech:5432/banco?sslmode=require

# Opcional: chave da Anthropic. Também pode ser cadastrada na tela de configuração da IA.
ANTHROPIC_API_KEY=
